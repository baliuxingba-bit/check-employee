// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TrackedItem {
  id               String    @id @default(cuid())
  category         String
  subject          String
  detail           String
  expiryDate       DateTime?
  notificationDate DateTime?
  notifiedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AbsenceRecord {
  id           String   @id @default(cuid())
  employeeName String
  date         DateTime
  type         String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id          String    @id @default(cuid())
  name        String    @unique
  affiliation String?
  joinDate    DateTime?
  birthDate   DateTime?
  createdAt   DateTime  @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ReportField {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

model ReportRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model DailyReport {
  id           String   @id @default(cuid())
  employeeName String
  date         DateTime
  content      String
  extraFields  Json?
  createdAt    DateTime @default(now())
}
